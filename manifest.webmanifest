---
layout: null
permalink: /manifest.webmanifest
---
{
  "name": {{ site.title | jsonify }},
  "short_name": "White Witch",
  "description": {{ site.description | jsonify }},
  "id": {{ '/' | relative_url | jsonify }},
  "start_url": {{ '/' | relative_url | jsonify }},
  "scope": {{ '/' | relative_url | jsonify }},
  "display": "standalone",
  "background_color": "#0a0a0a",
  "theme_color": "#0a0a0a",
  "lang": "en",
  "categories": ["news", "magazines"],
  "icons": [
    {
      "src": {{ '/assets/icons/icon-192.png' | relative_url | jsonify }},
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": {{ '/assets/icons/icon-512.png' | relative_url | jsonify }},
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": {{ '/assets/icons/icon-maskable-192.png' | relative_url | jsonify }},
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": {{ '/assets/icons/icon-maskable-512.png' | relative_url | jsonify }},
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Blog",
      "url": {{ '/blog/' | relative_url | jsonify }},
      "icons": [
        {
          "src": {{ '/assets/icons/icon-192.png' | relative_url | jsonify }},
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Rants",
      "url": {{ '/rants/' | relative_url | jsonify }},
      "icons": [
        {
          "src": {{ '/assets/icons/icon-192.png' | relative_url | jsonify }},
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": {{ '/assets/images/og.jpg' | relative_url | jsonify }},
      "sizes": "1200x630",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "The White Witch"
    }
  ]
}
